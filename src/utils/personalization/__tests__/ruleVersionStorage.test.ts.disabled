import { describe, it, expect, beforeEach, afterEach } from '@jest/globals';
import { ruleVersionStorage, RuleVersionStorage } from '../ruleVersionStorage';
import type { PersonalizationRuleVersion, PersonalizationRule } from '@/types/personalization';

const mockRule: PersonalizationRule = {
  id: 'rule_1',
  name: 'Test Rule',
  description: 'Test description',
  segment: 'new_visitor',
  trigger: 'on_page_load',
  contentType: 'blog_post',
  variants: [],
  isActive: true,
  priority: 1,
  conditions: [],
  createdAt: Date.now(),
  updatedAt: Date.now(),
};

describe('RuleVersionStorage', () => {
  beforeEach(() => {
    localStorage.clear();
    jest.clearAllMocks();
  });

  afterEach(() => {
    localStorage.clear();
  });

  afterEach(() => {
    localStorage.clear();
  });

  describe('getRuleVersions', () => {
    it('should return empty array when no versions exist', () => {
      const versions = ruleVersionStorage.getRuleVersions('rule_1');
      expect(versions).toEqual([]);
    });

    it('should return empty array when localStorage is empty', () => {
      localStorage.clear();
      const versions = ruleVersionStorage.getRuleVersions('rule_1');
      expect(versions).toEqual([]);
    });

    it('should return versions sorted by timestamp (newest first)', () => {
      const version1: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Version 1' },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'First version',
        author: 'test',
      };

      const version2: PersonalizationRuleVersion = {
        id: 'v2',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Version 2' },
        timestamp: '2024-01-02T10:00:00.000Z',
        notes: 'Second version',
        author: 'test',
      };

      ruleVersionStorage.saveVersion(version1);
      ruleVersionStorage.saveVersion(version2);

      const versions = ruleVersionStorage.getRuleVersions('rule_1');
      expect(versions).toHaveLength(2);
      expect(versions[0].name).toBe('Version 2');
      expect(versions[1].name).toBe('Version 1');
    });

    it('should handle corrupted localStorage data gracefully', () => {
      localStorage.setItem('personalization_rule_version_list_rule_1', 'invalid json');
      const versions = ruleVersionStorage.getRuleVersions('rule_1');
      expect(versions).toEqual([]);
    });
  });

  describe('saveVersion', () => {
    it('should save a version successfully', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      ruleVersionStorage.saveVersion(version);

      const saved = localStorage.getItem('personalization_rule_version_v1');
      expect(saved).toBeDefined();
      expect(JSON.parse(saved!)).toEqual(version);
    });

    it('should add version ID to rule version list', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      ruleVersionStorage.saveVersion(version);

      const list = JSON.parse(
        localStorage.getItem('personalization_rule_version_list_rule_1')!
      );
      expect(list).toContain('v1');
    });

    it('should not add duplicate version IDs', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      ruleVersionStorage.saveVersion(version);
      ruleVersionStorage.saveVersion(version);

      const list = JSON.parse(
        localStorage.getItem('personalization_rule_version_list_rule_1')!
      );
      expect(list).toEqual(['v1']);
    });

    it('should remove oldest versions when exceeding maxVersions', () => {
      const storage = new RuleVersionStorage({ maxVersions: 3 });

      for (let i = 1; i <= 5; i++) {
        const version: PersonalizationRuleVersion = {
          id: `v${i}`,
          ruleId: 'rule_1',
          content: { ...mockRule, name: `Version ${i}` },
          timestamp: `2024-01-0${i}T10:00:00.000Z`,
          notes: `Version ${i}`,
          author: 'test',
        };
        storage.saveVersion(version);
      }

      const versions = storage.getRuleVersions('rule_1');
      expect(versions).toHaveLength(3);
      expect(versions.map(v => v.name)).toEqual(['Version 5', 'Version 4', 'Version 3']);
    });

    it('should remove oldest version data from localStorage when exceeding maxVersions', () => {
      const storage = new RuleVersionStorage({ maxVersions: 2 });

      storage.saveVersion({
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Version 1',
        author: 'test',
      });

      storage.saveVersion({
        id: 'v2',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-02T10:00:00.000Z',
        notes: 'Version 2',
        author: 'test',
      });

      storage.saveVersion({
        id: 'v3',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-03T10:00:00.000Z',
        notes: 'Version 3',
        author: 'test',
      });

      expect(localStorage.getItem('personalization_rule_version_v1')).toBeNull();
      expect(localStorage.getItem('personalization_rule_version_v2')).not.toBeNull();
      expect(localStorage.getItem('personalization_rule_version_v3')).not.toBeNull();
    });
  });

  describe('deleteVersion', () => {
    it('should delete a version successfully', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      ruleVersionStorage.saveVersion(version);
      ruleVersionStorage.deleteVersion('rule_1', 'v1');

      expect(localStorage.getItem('personalization_rule_version_v1')).toBeNull();
    });

    it('should remove version ID from rule version list', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      ruleVersionStorage.saveVersion(version);
      ruleVersionStorage.deleteVersion('rule_1', 'v1');

      const list = localStorage.getItem('personalization_rule_version_list_rule_1');
      expect(list).toBeNull();
    });

    it('should handle deleting non-existent version gracefully', () => {
      expect(() => {
        ruleVersionStorage.deleteVersion('rule_1', 'non_existent');
      }).not.toThrow();
    });
  });

  describe('clearRuleVersions', () => {
    it('should clear all versions for a rule', () => {
      const versions: PersonalizationRuleVersion[] = [
        {
          id: 'v1',
          ruleId: 'rule_1',
          content: { ...mockRule },
          timestamp: '2024-01-01T10:00:00.000Z',
          notes: 'Version 1',
          author: 'test',
        },
        {
          id: 'v2',
          ruleId: 'rule_1',
          content: { ...mockRule },
          timestamp: '2024-01-02T10:00:00.000Z',
          notes: 'Version 2',
          author: 'test',
        },
      ];

      versions.forEach(v => ruleVersionStorage.saveVersion(v));
      ruleVersionStorage.clearRuleVersions('rule_1');

      const versionsAfter = ruleVersionStorage.getRuleVersions('rule_1');
      expect(versionsAfter).toHaveLength(0);
    });

    it('should remove version list key from localStorage', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Version 1',
        author: 'test',
      };

      ruleVersionStorage.saveVersion(version);
      ruleVersionStorage.clearRuleVersions('rule_1');

      expect(localStorage.getItem('personalization_rule_version_list_rule_1')).toBeNull();
    });
  });

  describe('compareVersions', () => {
    it('should detect added fields', () => {
      const version1: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Original' },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Version 1',
        author: 'test',
      };

      const version2: PersonalizationRuleVersion = {
        id: 'v2',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Updated', priority: 5 },
        timestamp: '2024-01-02T10:00:00.000Z',
        notes: 'Version 2',
        author: 'test',
      };

      const diffs = ruleVersionStorage.compareVersions(version1, version2);
      const priorityDiff = diffs.find(d => d.field === 'priority');
      expect(priorityDiff).toBeDefined();
      expect(priorityDiff?.type).toBe('added');
    });

    it('should detect removed fields', () => {
      const version1: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule, priority: 5 },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Version 1',
        author: 'test',
      };

      const version2: PersonalizationRuleVersion = {
        id: 'v2',
        ruleId: 'rule_1',
        content: { ...mockRule, priority: undefined as any },
        timestamp: '2024-01-02T10:00:00.000Z',
        notes: 'Version 2',
        author: 'test',
      };

      const diffs = ruleVersionStorage.compareVersions(version1, version2);
      const priorityDiff = diffs.find(d => d.field === 'priority');
      expect(priorityDiff).toBeDefined();
      expect(priorityDiff?.type).toBe('removed');
    });

    it('should detect changed fields', () => {
      const version1: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Original Name' },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Version 1',
        author: 'test',
      };

      const version2: PersonalizationRuleVersion = {
        id: 'v2',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Updated Name' },
        timestamp: '2024-01-02T10:00:00.000Z',
        notes: 'Version 2',
        author: 'test',
      };

      const diffs = ruleVersionStorage.compareVersions(version1, version2);
      const nameDiff = diffs.find(d => d.field === 'name');
      expect(nameDiff).toBeDefined();
      expect(nameDiff?.type).toBe('changed');
      expect(nameDiff?.oldValue).toBe('Original Name');
      expect(nameDiff?.newValue).toBe('Updated Name');
    });

    it('should return empty array when versions are identical', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Version 1',
        author: 'test',
      };

      const diffs = ruleVersionStorage.compareVersions(version, version);
      expect(diffs).toEqual([]);
    });

    it('should handle multiple changes', () => {
      const version1: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Original', priority: 1, isActive: true },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Version 1',
        author: 'test',
      };

      const version2: PersonalizationRuleVersion = {
        id: 'v2',
        ruleId: 'rule_1',
        content: { ...mockRule, name: 'Updated', priority: 5, isActive: false },
        timestamp: '2024-01-02T10:00:00.000Z',
        notes: 'Version 2',
        author: 'test',
      };

      const diffs = ruleVersionStorage.compareVersions(version1, version2);
      expect(diffs).toHaveLength(3);
    });
  });

  describe('getVersionCount', () => {
    it('should return 0 when no versions exist', () => {
      const count = ruleVersionStorage.getVersionCount('rule_1');
      expect(count).toBe(0);
    });

    it('should return correct version count', () => {
      const versions: PersonalizationRuleVersion[] = [
        {
          id: 'v1',
          ruleId: 'rule_1',
          content: { ...mockRule },
          timestamp: '2024-01-01T10:00:00.000Z',
          notes: 'Version 1',
          author: 'test',
        },
        {
          id: 'v2',
          ruleId: 'rule_1',
          content: { ...mockRule },
          timestamp: '2024-01-02T10:00:00.000Z',
          notes: 'Version 2',
          author: 'test',
        },
        {
          id: 'v3',
          ruleId: 'rule_1',
          content: { ...mockRule },
          timestamp: '2024-01-03T10:00:00.000Z',
          notes: 'Version 3',
          author: 'test',
        },
      ];

      versions.forEach(v => ruleVersionStorage.saveVersion(v));
      const count = ruleVersionStorage.getVersionCount('rule_1');
      expect(count).toBe(3);
    });
  });

  describe('Edge Cases', () => {
    it('should handle rule IDs with special characters', () => {
      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule-with-special-chars_123',
        content: { ...mockRule },
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      expect(() => {
        ruleVersionStorage.saveVersion(version);
      }).not.toThrow();

      const versions = ruleVersionStorage.getRuleVersions('rule-with-special-chars_123');
      expect(versions).toHaveLength(1);
    });

    it('should handle very large content objects', () => {
      const largeContent = {
        ...mockRule,
        description: 'x'.repeat(10000),
      };

      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: largeContent,
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      expect(() => {
        ruleVersionStorage.saveVersion(version);
      }).not.toThrow();

      const versions = ruleVersionStorage.getRuleVersions('rule_1');
      expect(versions[0].description).toHaveLength(10000);
    });

    it('should handle Unicode characters in content', () => {
      const unicodeContent = {
        ...mockRule,
        name: 'Test ñ 中文 العربية',
        description: 'Test with emoji 😊 and symbols ©®™',
      };

      const version: PersonalizationRuleVersion = {
        id: 'v1',
        ruleId: 'rule_1',
        content: unicodeContent,
        timestamp: '2024-01-01T10:00:00.000Z',
        notes: 'Test version',
        author: 'test',
      };

      expect(() => {
        ruleVersionStorage.saveVersion(version);
      }).not.toThrow();

      const versions = ruleVersionStorage.getRuleVersions('rule_1');
      expect(versions[0].name).toBe('Test ñ 中文 العربية');
    });
  });
});
