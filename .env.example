# Environment Variables untuk Maskom
# Copy file ini ke .env.local dan isi nilai yang sesuai

# Jika ada API keys atau konfigurasi eksternal, tambahkan di sini
# Contoh:
# NEXT_PUBLIC_API_URL=https://api.example.com
# DATABASE_URL=postgresql://...

# EmailJS Credentials (Client-side)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Site URL Configuration
# Production: https://maskom.co.id
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://maskom.co.id

# CORS Configuration
# Allowed origin for Cross-Origin Resource Sharing
# Production: https://maskom.co.id
# Development: http://localhost:3000
NEXT_PUBLIC_CORS_ORIGIN=https://maskom.co.id

# CDN Configuration (Optional)
# CDN base URL for asset serving
# Example: https://cdn.example.com
# Leave empty to disable CDN
CDN_URL=

# CDN Provider Configuration (Cloudflare)
# Cloudflare API Key for cache management
CDN_API_KEY=
CDN_ZONE_ID=
CDN_ACCOUNT_ID=

