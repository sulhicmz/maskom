{
   "info": {
     "name": "Maskom API Collection",
     "description": "Postman collection for Maskom monitoring and health check endpoints (v3.0.0 - ServiceResult<T> pattern)",
     "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
     "version": "3.0.0"
   },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "threshold",
      "value": "0.9",
      "type": "string",
      "description": "Health check success rate threshold (0-1)"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Get Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Performs health check for all services with configurable success rate threshold"
          },
          "response": []
        },
        {
          "name": "Get Health Status with Custom Threshold",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health?threshold={{threshold}}",
              "host": ["{{baseUrl}}"],
              "path": ["health"],
              "query": [
                {
                  "key": "threshold",
                  "value": "{{threshold}}",
                  "description": "Success rate threshold (0-1, default: 0.9)"
                }
              ]
            },
            "description": "Performs health check with custom success rate threshold (e.g., 0.8 for 80%)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Monitoring",
      "item": [
        {
          "name": "Get All Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["metrics"]
            },
            "description": "Retrieves metrics for all monitored services including success rates and health status"
          },
          "response": []
        },
        {
          "name": "Get Service Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/status",
              "host": ["{{baseUrl}}"],
              "path": ["services", "status"]
            },
            "description": "Retrieves detailed status for EmailService and AuthService including metrics and circuit breaker states"
          },
          "response": []
        }
      ]
    }
  ]
}
