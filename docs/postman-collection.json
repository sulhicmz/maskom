{
  "info": {
    "name": "Maskom Frontend Services Testing",
    "description": "**IMPORTANT**: These are NOT REST API endpoints. These are frontend TypeScript services (EmailService, AuthService) that are tested via Jest. This Postman collection demonstrates the service interfaces but should be used with Jest for actual testing. See docs/api/email-service.md and docs/api/auth-service.md for proper usage examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Frontend application URL (services run client-side)"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token from login/register (for reference)"
    }
  ],
  "item": [
    {
      "name": "Email Service",
      "item": [
        {
          "name": "Send Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateParams\": {\n    \"user_name\": \"John Doe\",\n    \"user_email\": \"john@example.com\",\n    \"message\": \"Hello, I would like to inquire about your services.\"\n  },\n  \"skipRateLimit\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}} (Frontend Service - see src/services/email/EmailService.ts)",
              "host": ["{{baseUrl}}"],
              "path": []
            }
          },
          "response": []
        },
        {
          "name": "Send Email - Rate Limit Bypass (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateParams\": {\n    \"user_name\": \"Admin Test\",\n    \"user_email\": \"admin@maskom.co.id\",\n    \"message\": \"Admin test email\"\n  },\n  \"skipRateLimit\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/email/send",
              "host": ["{{baseUrl}}"],
              "path": ["email", "send"]
            }
          },
          "response": []
        },
        {
          "name": "Send Email - Invalid Email (Error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateParams\": {\n    \"user_name\": \"Test User\",\n    \"user_email\": \"invalid-email\",\n    \"message\": \"Test message\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/email/send",
              "host": ["{{baseUrl}}"],
              "path": ["email", "send"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication Service",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "  pm.collectionVariables.set('token', jsonData.token);",
                  "  pm.test('Token saved to collection variables', true);",
                  "} else {",
                  "  pm.test('Login failed or no token returned', false);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login - Invalid Credentials (Error)",
          "request": {
