    {
      "name": "Integration Tests",
      "item": [
        {
          "name": "Complete Auth Flow",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Create unique email for each test run",
                  "var timestamp = Date.now();",
                  "pm.collectionVariables.set('testEmail', 'test' + timestamp + '@example.com');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "item": [
            {
              "name": "1. Register User",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.test('Registration successful', jsonData.success === true);",
                      "pm.test('User object returned', jsonData.user !== undefined);",
                      "pm.test('Token returned', jsonData.token !== undefined);",
                      "if (jsonData.success) {",
                      "  pm.collectionVariables.set('token', jsonData.token);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Integration Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"testpassword123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/register",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "register"]
                }
              },
              "response": []
            },
            {
              "name": "2. Get Current User",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.test('User retrieved successfully', jsonData.id !== undefined);",
                      "pm.test('Email matches', jsonData.email === pm.collectionVariables.get('testEmail'));",
                      "pm.test('Name matches', jsonData.name === 'Integration Test User');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/auth/current-user",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "current-user"]
                }
              },
              "response": []
            },
            {
              "name": "3. Logout",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.test('Logout successful', jsonData.success === true);",
                      "pm.test('Logout message present', jsonData.message !== undefined);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{}"
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/logout",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "logout"]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Email Service with Validation",
          "item": [
            {
              "name": "1. Send Valid Email",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.test('Email sent successfully', jsonData.success === true);",
                      "pm.test('Response text present', jsonData.data !== undefined);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"templateParams\": {\n    \"user_name\": \"Test User\",\n    \"user_email\": \"test@example.com\",\n    \"message\": \"Test message from Postman\"\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/email/send",
                  "host": ["{{baseUrl}}"],
                  "path": ["email", "send"]
                }
              },
              "response": []
            },
            {
              "name": "2. Send Email - Missing Name (Error)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.test('Request failed as expected', jsonData.success === false);",
                      "pm.test('Validation error code', jsonData.errorCode === 'VALIDATION_ERROR');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"templateParams\": {\n    \"user_email\": \"test@example.com\",\n    \"message\": \"Test message\"\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/email/send",
                  "host": ["{{baseUrl}}"],
                  "path": ["email", "send"]
                }
              },
              "response": []
            }
          ]
        }
      ]
    }
  ]
