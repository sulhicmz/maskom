# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare
.open-next/
.wrangler/
.cloudflare/

# typescript
*.tsbuildinfo
next-env.d.ts
firebase-debug.log

# OpenNext build artifacts
.open-next/**/*
!.open-next/config.json

# Cloudflare build artifacts
.wrangler/**
.cloudflare/**

# IDE files
.vscode/*
!.vscode/settings.json
.idea/

# OS generated files
Thumbs.db
ehthumbs.db
Icon?
.DS_Store

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.next/standalone/**

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.test

# next-on-netlify
/netlify/

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS
.tern-project
.tern-port
.tern-defs

# Parcel cache (https://parceljs.org/)
.cache

# Fnm (functional node manager)
.fnm/

# Nx cache
/.nx/

# Prisma generated files
prisma/migrations/

# Rome formatter
rome/

# Rust
/target/

# Docker
.docker/

# Temporary VSCode files
.vscode/tasks.json
.vscode/launch.json

# Local configuration files that might be generated
config.local.json
